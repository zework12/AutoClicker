<Window x:Class="AutoClicker.Views.PointPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор точки"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#59070A10"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="400" Height="300"
        Cursor="Cross"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonDown="OnLeftDown"
        MouseRightButtonDown="OnRightDown">

  <Canvas x:Name="Root">
    <!-- Follows the cursor and shows the point a click would pick. -->
    <Border x:Name="Tip"
            Background="{StaticResource OverlayBackground}"
            BorderBrush="{StaticResource OverlayBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="11,8"
            IsHitTestVisible="False"
            Visibility="Hidden">
      <StackPanel>
        <TextBlock x:Name="Coordinates"
                   Foreground="{StaticResource TextPrimary}"
                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text="Клик — выбрать точку · Esc — отмена"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="Segoe UI" FontSize="11"
                   Margin="0,3,0,0" />
      </StackPanel>
    </Border>
  </Canvas>
</Window>
