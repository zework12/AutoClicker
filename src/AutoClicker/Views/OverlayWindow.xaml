<Window x:Class="AutoClicker.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автокликер — оверлей"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        SourceInitialized="OnSourceInitialized"
        SizeChanged="OnSizeChanged">

  <Border x:Name="Root"
          Background="{StaticResource OverlayBackground}"
          BorderBrush="{StaticResource OverlayBorder}"
          BorderThickness="1"
          CornerRadius="9"
          Padding="11,8,12,7"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True"
          TextElement.FontFamily="Segoe UI"
          TextElement.FontSize="12"
          TextElement.Foreground="{StaticResource TextPrimary}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <!-- Wide enough for the longest state, so the pill doesn't jump as numbers change. -->
        <ColumnDefinition Width="Auto" MinWidth="132" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="19" />
        <RowDefinition Height="19" />
        <RowDefinition Height="19" />
        <RowDefinition Height="19" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Ellipse x:Name="MouseDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,8,0" />
      <TextBlock x:Name="MouseName" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock x:Name="MouseState" Grid.Column="2" Margin="14,0,0,0"
                 HorizontalAlignment="Right" VerticalAlignment="Center" />

      <Ellipse x:Name="KeyDot" Grid.Row="1" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,8,0" />
      <TextBlock x:Name="KeyName" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                 MaxWidth="130" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="KeyState" Grid.Row="1" Grid.Column="2" Margin="14,0,0,0"
                 HorizontalAlignment="Right" VerticalAlignment="Center" />

      <Ellipse x:Name="CamDot" Grid.Row="2" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,8,0" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="Камера" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock x:Name="CamState" Grid.Row="2" Grid.Column="2" Margin="14,0,0,0"
                 HorizontalAlignment="Right" VerticalAlignment="Center" />

      <Ellipse x:Name="RndDot" Grid.Row="3" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,8,0" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="Макрос" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock x:Name="RndState" Grid.Row="3" Grid.Column="2" Margin="14,0,0,0"
                 HorizontalAlignment="Right" VerticalAlignment="Center" />

      <TextBlock x:Name="MenuHint" Grid.Row="4" Grid.ColumnSpan="3"
                 Foreground="{StaticResource TextFaint}"
                 FontSize="10.5"
                 Margin="0,3,0,0"
                 HorizontalAlignment="Right" />
    </Grid>
  </Border>
</Window>
